{
  "compilerOptions": {
      "moduleResolution": "nodenext",
      "outDir": "lib",
      "rootDir": "src",
      "module": "nodenext",
      "target": "ES2019",
      "declaration": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "sourceMap": true,
      "lib": ["ES2019", "DOM"]
  },
  "include": ["src"]
}
